# Copied to .env automatically by ./setup.sh and the Docker make targets.
# Edit .env before exposing this instance publicly.
# docker compose reads this file automatically.

# --- Database -----------------------------------------------------------------
# Postgres is only reachable on the internal compose network by default; it is not
# published to the host. Change the password for any real deployment.
POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change-me-before-production

# --- Django -------------------------------------------------------------------
# Leave SECRET_KEY empty to have one generated and persisted on first boot.
# Set it explicitly for production so it survives container recreation.
SECRET_KEY=

DEBUG=False
DJANGO_ENV=production

# Space- or comma-separated. "*" accepts any host, so the stack works whether
# you browse it via localhost, a LAN IP, or a hostname - safe with the shipped
# same-origin nginx proxy (the browser never talks to Django cross-origin).
# Pin it to your real hostname for an internet-facing instance:
#   DJANGO_ALLOWED_HOSTS=fintrack.example.com
DJANGO_ALLOWED_HOSTS=*

# Only consulted for cross-origin setups (serving the web UI and API from
# different origins). The default Docker stack proxies /api/ same-origin, so
# these never come into play there - but set them to your real origin if you
# split the two apart.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Set to False when serving over plain HTTP (LAN, local reverse proxy, testing).
SECURE_SSL=False

# --- Optional: bootstrap an admin account -------------------------------------
# Both must be set for an admin to be created. There is no default password.
# Leave these empty and register the first account through the web UI instead.
FINTRACK_ADMIN_EMAIL=
FINTRACK_ADMIN_PASSWORD=

# --- Optional: analytics ------------------------------------------------------
# Empty means no analytics of any kind. Self-hosted instances phone home to
# nobody unless you fill these in with your own Umami instance.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# --- Optional: outbound email (notifications) ----------------------------------
# Powers the email channel in Settings > Notifications - budget alerts, bill
# reminders, the weekly digest. Leave EMAIL_HOST empty and the console
# backend takes over: notifications still fire, they just print to the
# api/worker container logs (`docker compose logs worker`) instead of
# sending real mail - fine for trying the feature, not for actually
# receiving it. See docs/self-hosting.md#email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=FinTrack <notifications@fintrack.local>

# --- Optional: bank sync (GoCardless) ------------------------------------------
# Powers Settings > Bank Sync's "Connect a bank" flow for GoCardless Bank
# Account Data (EU/UK). Free at https://bankaccountdata.gocardless.com/ - register,
# create an API key pair, and paste it here. Leave empty and GoCardless simply
# will not show up as an option; SimpleFIN Bridge (US/CA) needs none of this,
# each user pastes their own bridge's setup token directly in the UI. See
# docs/self-hosting.md#bank-sync.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Encrypts stored bank sync credentials at rest (pft/crypto.py). Leave empty
# and SECRET_KEY is reused for this too - fine locally, but set your own here
# for production so rotating SECRET_KEY does not also strand every bank
# connection.
FINTRACK_SYNC_ENCRYPTION_KEY=

# Where FinTrack's own web app is reachable, so GoCardless can send users back
# here after they finish authenticating at their bank. Set this to your real
# hostname (e.g. https://fintrack.example.com) once DJANGO_ALLOWED_HOSTS/
# CORS_ALLOWED_ORIGINS above are no longer localhost.
FINTRACK_FRONTEND_URL=http://localhost:5173

# Only needed when running the API outside Docker (`make install && make run`).
# For the Docker stack, use the .env file at the repository root instead.

# Leave empty to have a key generated and saved to api/.secret_key on first boot.
SECRET_KEY=

DEBUG=True
DJANGO_ENV=development

# Space- or comma-separated.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Point at your local Postgres.
DATABASE_NAME=fintrack
DATABASE_USER=fintrack
DATABASE_PASSWORD=fintrack
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Only needed when running the API outside Docker (`make install && make run`).
# For the Docker stack, use the .env file at the repository root instead.

# Leave empty to have a key generated and saved to api/.secret_key on first boot.
SECRET_KEY=

DEBUG=True
DJANGO_ENV=development

# Space- or comma-separated.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Point at your local Postgres.
DATABASE_NAME=fintrack
DATABASE_USER=fintrack
DATABASE_PASSWORD=fintrack
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Alternative to the five DATABASE_* vars above: a single connection string,
# as handed out by Render/Railway/Heroku-style platforms. Takes priority over
# the discrete vars when set - see docs/one-click-deploy.md.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Outbound email for the notifications engine (budget alerts, bill reminders,
# weekly digest). Leave EMAIL_HOST empty for the console backend - emails
# print to this process's stdout instead of sending. See docs/self-hosting.md#email.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=FinTrack <notifications@fintrack.local>

#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/markdown-it@14.3.0/node_modules/markdown-it/node_modules:/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/markdown-it@14.3.0/node_modules:/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/markdown-it@14.3.0/node_modules/markdown-it/node_modules:/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/markdown-it@14.3.0/node_modules:/Users/ashish/Developer/sandbox/fintrack/packages/sdk-ts/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/markdown-it.mjs" "$@"
else
  exec node  "$basedir/../../bin/markdown-it.mjs" "$@"
fi

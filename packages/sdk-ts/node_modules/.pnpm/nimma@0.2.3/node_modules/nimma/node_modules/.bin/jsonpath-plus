fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../jsonpath-plus@10.4.0/node_modules/jsonpath-plus/bin/jsonpath-cli.js" "$@"
else
  exec node  "$basedir/../../../../../jsonpath-plus@10.4.0/node_modules/jsonpath-plus/bin/jsonpath-cli.js" "$@"
fi
